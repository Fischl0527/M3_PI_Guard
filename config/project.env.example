# M3 PI Guard unified local configuration template.
#
# Copy this file to config/project.local.env and edit only the local copy.
# project.local.env is ignored by Git and must never be uploaded or committed.

# ---------------------------------------------------------------------------
# Secrets: every team member uses their own credentials.
# ---------------------------------------------------------------------------
HF_TOKEN=__SET_LOCALLY__
OPENAI_API_KEY=__OPTIONAL_SET_LOCALLY__
ANTHROPIC_API_KEY=__OPTIONAL_SET_LOCALLY__
DEEPSEEK_API_KEY=__OPTIONAL_SET_LOCALLY__
GEMINI_API_KEY=__OPTIONAL_SET_LOCALLY__

# ---------------------------------------------------------------------------
# Optional frontier API model slots for Q2-grade generalization evidence.
# Leave placeholders unless the team has explicit approval to run network
# smoke/formal experiments. Keys remain in project.local.env only.
# ---------------------------------------------------------------------------
M3_FRONTIER_API_CONSENT=__OPTIONAL_SET_LOCALLY__
FRONTIER_OPENAI_MODEL_ID=__OPTIONAL_SET_LOCALLY__
FRONTIER_OPENAI_BASE_URL=__OPTIONAL_SET_LOCALLY__
FRONTIER_ANTHROPIC_MODEL_ID=__OPTIONAL_SET_LOCALLY__
FRONTIER_ANTHROPIC_BASE_URL=__OPTIONAL_SET_LOCALLY__
FRONTIER_DEEPSEEK_MODEL_ID=deepseek-v4-pro
FRONTIER_DEEPSEEK_BASE_URL=https://api.deepseek.com
FRONTIER_GEMINI_MODEL_ID=gemini-3.6-flash
FRONTIER_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ---------------------------------------------------------------------------
# Machine-local runtime and cache paths. Change these after migration.
# ---------------------------------------------------------------------------
M3_RUNTIME_ROOT=E:\M3_PI_Guard_runtime
HF_HOME=E:\AI_Cache\huggingface
HF_HUB_CACHE=E:\AI_Cache\huggingface\hub
OLLAMA_MODELS=E:\Ollama\models
M3_PRIVATE_DATA_ROOT=__OPTIONAL_LOCAL_PATH__

# ---------------------------------------------------------------------------
# Local model service.
# ---------------------------------------------------------------------------
M3_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
M3_OLLAMA_API_KEY=ollama

# ---------------------------------------------------------------------------
# PromptGuard reproducibility contract. Keep these values shared and frozen.
# ---------------------------------------------------------------------------
PROMPTGUARD_MODEL_ID=meta-llama/Llama-Prompt-Guard-2-86M
PROMPTGUARD_REVISION=a8ded8e697ce7c355e395a0df51f94adb4a2fd27
PROMPTGUARD_THRESHOLD=0.5
PROMPTGUARD_CHUNK_TOKEN_LIMIT=512
PROMPTGUARD_DOWNLOAD_SNAPSHOT=E:\M3_PI_Guard_runtime\promptguard\evidence\promptguard_download_snapshot.json
