{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://m3-pi-guard.local/schemas/paper_v1/task_policy_manifest.schema.json",
  "title": "M3 paper-v1 TaskPolicyManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "policy_source", "trusted_request_sha256", "tool_schema_sha256", "rules", "temporal_constraints", "dataflow_constraints", "sensitive_data_labels", "approvals", "version", "generated_at", "manifest_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "manifest_id": {"type": "string", "minLength": 1},
    "policy_source": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["trusted_user_request", "trusted_application_context", "independent_confirmation"]}
    },
    "trusted_request_sha256": {"$ref": "#/$defs/sha256"},
    "tool_schema_sha256": {"$ref": "#/$defs/sha256"},
    "rules": {"type": "array", "items": {"$ref": "#/$defs/tool_rule"}},
    "temporal_constraints": {"type": "array", "items": {"$ref": "#/$defs/temporal"}},
    "dataflow_constraints": {"type": "array", "items": {"$ref": "#/$defs/dataflow"}},
    "sensitive_data_labels": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "approvals": {"type": "array", "items": {"$ref": "#/$defs/approval"}},
    "version": {"type": "integer", "minimum": 1},
    "parent_manifest_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "generated_at": {"type": "string", "format": "date-time"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value", "required", "description"],
      "properties": {
        "kind": {"enum": ["any", "exact", "enum", "prefix", "regex", "type"]},
        "value": {},
        "required": {"type": "boolean"},
        "description": {"type": "string"}
      }
    },
    "tool_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "tool", "argument_constraints", "permitted_argument_sources", "requires_confirmation", "side_effect", "description"],
      "properties": {
        "rule_id": {"type": "string"},
        "tool": {"type": "string"},
        "argument_constraints": {"type": "object", "additionalProperties": {"$ref": "#/$defs/constraint"}},
        "permitted_argument_sources": {"type": "array", "items": {"type": "string"}},
        "requires_confirmation": {"type": "boolean"},
        "side_effect": {"type": "boolean"},
        "description": {"type": "string"}
      }
    },
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constraint_id", "tool", "must_follow_tools", "description"],
      "properties": {
        "constraint_id": {"type": "string"},
        "tool": {"type": "string"},
        "must_follow_tools": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "description": {"type": "string"}
      }
    },
    "dataflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constraint_id", "data_label", "forbidden_tools", "forbidden_target_patterns", "description"],
      "properties": {
        "constraint_id": {"type": "string"},
        "data_label": {"type": "string"},
        "forbidden_tools": {"type": "array", "items": {"type": "string"}},
        "forbidden_target_patterns": {"type": "array", "items": {"type": "string"}},
        "description": {"type": "string"}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approval_id", "approver_id", "proposal_sha256", "approved_scope", "reason", "approved_at", "confirmation_channel", "record_sha256"],
      "properties": {
        "approval_id": {"type": "string"},
        "approver_id": {"type": "string", "minLength": 1},
        "proposal_sha256": {"$ref": "#/$defs/sha256"},
        "approved_scope": {"type": "object"},
        "reason": {"type": "string"},
        "approved_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "confirmation_channel": {"const": "independent_interface"},
        "record_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
