{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://m3-pi-guard.local/schemas/paper_v1/guard_decision.schema.json",
  "title": "M3 paper-v1 GuardDecision",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "decision_id", "proposal_sha256", "manifest_sha256", "rule_id", "violated_rules", "evidence_paths", "reason", "suggested_recovery", "decided_at"],
  "properties": {
    "decision": {"enum": ["ALLOW", "ASK", "DENY"]},
    "decision_id": {"type": "string"},
    "proposal_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rule_id": {"type": ["string", "null"]},
    "violated_rules": {"type": "array", "items": {"type": "string"}},
    "evidence_paths": {"type": "array", "items": {"type": "string"}},
    "reason": {"type": "string"},
    "suggested_recovery": {"type": "string"},
    "decided_at": {"type": "string", "format": "date-time"}
  }
}
