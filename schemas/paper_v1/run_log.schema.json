{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://m3-pi-guard.local/schemas/paper_v1/run_log.schema.json",
  "title": "M3 paper-v1 RunLog",
  "type": "object",
  "required": ["schema_version", "runtime_version", "run_id", "run_key", "case_id", "step", "backend", "model", "oracle_stub", "effectiveness_eligible", "prompt_sha256", "policy_manifest_sha256", "policy_source", "action_proposal", "guard_decision", "tool_execution_attempted", "model_latency_ms", "guard_latency_ms", "tool_latency_ms", "final_status"],
  "properties": {
    "schema_version": {"const": "paper-run-log-1.0"},
    "runtime_version": {"type": "string"},
    "run_id": {"type": "string"},
    "run_key": {"type": "string"},
    "case_id": {"type": "string"},
    "step": {"type": "integer", "minimum": 1},
    "backend": {"type": "string"},
    "model": {"type": "string"},
    "temperature": {"type": "number"},
    "seed": {"type": ["integer", "null"]},
    "replicate_id": {"type": "integer", "minimum": 0},
    "oracle_stub": {"type": "boolean"},
    "effectiveness_eligible": {"type": "boolean"},
    "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy_manifest_version": {"type": "integer", "minimum": 1},
    "policy_regime": {"type": "string"},
    "policy_source": {"type": "array", "items": {"type": "string"}},
    "action_proposal": {"$ref": "action_proposal.schema.json"},
    "guard_decision": {"$ref": "guard_decision.schema.json"},
    "tool_execution_attempted": {"type": "boolean"},
    "tool_execution_succeeded": {"type": "boolean"},
    "model_latency_ms": {"type": "number", "minimum": 0},
    "guard_latency_ms": {"type": "number", "minimum": 0},
    "tool_latency_ms": {"type": "number", "minimum": 0},
    "final_status": {"enum": ["running", "completed", "max_steps_reached", "timeout", "error"]}
  },
  "additionalProperties": true
}
