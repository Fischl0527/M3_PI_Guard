{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://m3-pi-guard.local/schemas/paper_v2/formal_analysis_amendment_v7.schema.json",
  "title": "M3-PI Guard post-admission analysis amendment v7",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "artifact_role",
    "status",
    "run_id",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "m3-paper-v2-formal-analysis-amendment-7.0"
    },
    "artifact_role": {
      "enum": [
        "analysis_amendment_qualification",
        "analysis_amendment_candidate"
      ]
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "const": "paper-v2-deepseek-medium-v8-v9-analysis-amendment-v7-20260726"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
