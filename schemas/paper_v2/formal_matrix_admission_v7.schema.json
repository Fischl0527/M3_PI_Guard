{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://m3-pi-guard.local/schemas/paper_v2/formal_matrix_admission_v7.schema.json",
  "title": "M3 paper-v2 end-to-end boundary matrix admission v7",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "status",
    "artifact_role",
    "scope",
    "scope_sha256",
    "authorization",
    "evidence_boundary",
    "next_gate",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "m3-paper-v2-formal-matrix-admission-7.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "candidate_pending_six_condition_canary",
        "activated_for_six_condition_canary",
        "activated_for_matrix_continuation"
      ]
    },
    "artifact_role": {
      "enum": [
        "owner_review_candidate",
        "six_condition_canary_execution_authorization",
        "medium_matrix_continuation_authorization"
      ]
    },
    "scope": {
      "type": "object"
    },
    "scope_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "authorization": {
      "$ref": "#/$defs/authorization"
    },
    "evidence_boundary": {
      "$ref": "#/$defs/evidence_boundary"
    },
    "next_gate": {
      "type": "string",
      "minLength": 1
    },
    "manifest_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "owner_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_kind",
        "approved_by_role",
        "approved_at",
        "approval_scope",
        "statement_sha256"
      ],
      "properties": {
        "approval_kind": {
          "const": "delegated_safe_api_iteration"
        },
        "approved_by_role": {
          "const": "project_owner"
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "approval_scope": {
          "enum": [
            "deepseek_v7_six_condition_canary",
            "deepseek_v7_medium_matrix_continuation"
          ]
        },
        "statement_sha256": {
          "const": "2194cd7fd6734d220f7b38cd64fd717df8717270f0034dcaebece42185269ef2"
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_only",
        "canary_execution_authorized",
        "matrix_continuation_authorized",
        "result_admission_authorized",
        "candidate_manifest_sha256",
        "canary_review_sha256",
        "owner_approval"
      ],
      "properties": {
        "candidate_only": {
          "type": "boolean"
        },
        "canary_execution_authorized": {
          "type": "boolean"
        },
        "matrix_continuation_authorized": {
          "type": "boolean"
        },
        "result_admission_authorized": {
          "const": false
        },
        "candidate_manifest_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sha256"
            }
          ]
        },
        "canary_review_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sha256"
            }
          ]
        },
        "owner_approval": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/owner_approval"
            }
          ]
        }
      }
    },
    "evidence_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credentials_read_while_building",
        "network_calls_while_building",
        "formal_results_created",
        "candidate_is_executable",
        "prior_runs_resumed"
      ],
      "properties": {
        "credentials_read_while_building": {
          "const": false
        },
        "network_calls_while_building": {
          "const": 0
        },
        "formal_results_created": {
          "const": 0
        },
        "candidate_is_executable": {
          "const": false
        },
        "prior_runs_resumed": {
          "const": false
        }
      }
    }
  }
}
