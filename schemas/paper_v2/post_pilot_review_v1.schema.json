{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://m3-pi-guard.local/schemas/paper_v2/post_pilot_review_v1.schema.json",
  "title": "M3-PI Guard DeepSeek post-pilot evidence review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "status",
    "evidence_mode",
    "inputs",
    "checks",
    "observations",
    "decision",
    "review_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "m3-paper-v2-post-pilot-review-1.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "offline_reviewer_qualification_pass",
        "official_pilot_technical_gate_pass",
        "pilot_technical_gate_hold"
      ]
    },
    "evidence_mode": {
      "enum": [
        "offline_injected_qualification",
        "official_single_pilot"
      ]
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_manifest_sha256",
        "candidate_scope_sha256",
        "active_manifest_sha256",
        "active_file_sha256",
        "run_id",
        "work_key",
        "record_id",
        "record_sha256",
        "record_entry_sha256",
        "record_ledger_tail_sha256",
        "provider_trace_rows_sha256",
        "provider_trace_tail_sha256",
        "provider_trace_bundle_sha256"
      ],
      "properties": {
        "candidate_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidate_scope_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "active_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "active_file_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "work_key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "record_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "record_entry_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "record_ledger_tail_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "provider_trace_rows_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "provider_trace_tail_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "provider_trace_bundle_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "passed"],
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1
          },
          "passed": {
            "const": true
          }
        }
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "model_id",
        "provider_response_ids",
        "request_count",
        "completed_request_count",
        "open_request_count",
        "result_tier",
        "operational_status",
        "task_completion",
        "unsafe_effect",
        "included_in_intention_to_treat",
        "cache_accounting_complete",
        "prompt_tokens",
        "prompt_cache_hit_tokens",
        "prompt_cache_miss_tokens",
        "completion_tokens",
        "cumulative_cost_cny",
        "abort_ceiling_cny",
        "within_abort_ceiling",
        "safety_receipt_sha256",
        "safety_effect_backend",
        "safety_tool",
        "external_connectors_enabled",
        "provider_managed_tools_enabled"
      ],
      "properties": {
        "provider_id": {
          "const": "deepseek"
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "provider_response_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "request_count": {
          "type": "integer",
          "minimum": 1
        },
        "completed_request_count": {
          "type": "integer",
          "minimum": 0
        },
        "open_request_count": {
          "type": "integer",
          "minimum": 0
        },
        "result_tier": {
          "enum": ["diagnostic", "formal_candidate"]
        },
        "operational_status": {
          "type": "string",
          "minLength": 1
        },
        "task_completion": {
          "type": "boolean"
        },
        "unsafe_effect": {
          "type": ["boolean", "null"]
        },
        "included_in_intention_to_treat": {
          "const": true
        },
        "cache_accounting_complete": {
          "type": "boolean"
        },
        "prompt_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "prompt_cache_hit_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "prompt_cache_miss_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "completion_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cumulative_cost_cny": {
          "type": "number",
          "minimum": 0
        },
        "abort_ceiling_cny": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "within_abort_ceiling": {
          "type": "boolean"
        },
        "safety_receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "safety_effect_backend": {
          "enum": [
            "no_effect",
            "m3_sandbox_fixture",
            "agentdojo_in_memory_copy"
          ]
        },
        "safety_tool": {
          "type": "string",
          "minLength": 1
        },
        "external_connectors_enabled": {
          "const": false
        },
        "provider_managed_tools_enabled": {
          "const": false
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "structural_evidence_gate_passed",
        "official_evidence_gate_passed",
        "ready_for_owner_matrix_review",
        "owner_matrix_review_required",
        "formal_matrix_authorized",
        "result_admission_authorized",
        "reason_codes",
        "next_gate"
      ],
      "properties": {
        "structural_evidence_gate_passed": {
          "type": "boolean"
        },
        "official_evidence_gate_passed": {
          "type": "boolean"
        },
        "ready_for_owner_matrix_review": {
          "type": "boolean"
        },
        "owner_matrix_review_required": {
          "const": true
        },
        "formal_matrix_authorized": {
          "const": false
        },
        "result_admission_authorized": {
          "const": false
        },
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "next_gate": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "review_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
