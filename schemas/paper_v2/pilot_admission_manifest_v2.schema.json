{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://m3-pi-guard.local/schemas/paper_v2/pilot_admission_manifest_v2.schema.json",
  "title": "M3 paper-v2 single-pilot admission manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "status",
    "artifact_role",
    "scope",
    "scope_sha256",
    "authorization",
    "evidence_boundary",
    "next_gate",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "m3-paper-v2-pilot-admission-manifest-2.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "candidate_pending_owner_activation",
        "activated_for_single_deepseek_pilot"
      ]
    },
    "artifact_role": {
      "enum": [
        "owner_review_candidate",
        "single_pilot_execution_authorization"
      ]
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "scope_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "authorization": {
      "$ref": "#/$defs/authorization"
    },
    "evidence_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credentials_read_while_building",
        "network_calls_while_building",
        "formal_results_created",
        "candidate_is_executable"
      ],
      "properties": {
        "credentials_read_while_building": {
          "const": false
        },
        "network_calls_while_building": {
          "const": 0
        },
        "formal_results_created": {
          "const": 0
        },
        "candidate_is_executable": {
          "const": false
        }
      }
    },
    "next_gate": {
      "type": "string",
      "minLength": 1
    },
    "manifest_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "project_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "locked_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/project_path"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "endpoint_type",
        "base_url",
        "model_id",
        "temperature",
        "max_tokens",
        "timeout_seconds",
        "max_provider_calls",
        "automatic_retries",
        "cross_provider_fallback",
        "provider_managed_tools"
      ],
      "properties": {
        "provider_id": {
          "const": "deepseek"
        },
        "endpoint_type": {
          "const": "official_api"
        },
        "base_url": {
          "const": "https://api.deepseek.com"
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "temperature": {
          "const": 0.0
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 120
        },
        "max_provider_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "automatic_retries": {
          "const": 0
        },
        "cross_provider_fallback": {
          "const": false
        },
        "provider_managed_tools": {
          "const": false
        }
      }
    },
    "work_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "work_key",
        "execution_identity",
        "selection_id",
        "case_id",
        "benchmark",
        "condition_id",
        "evaluation_case_type",
        "authorization_regime",
        "analysis_tier",
        "source_record_sha256",
        "work_item_sha256"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "work_key": {
          "$ref": "#/$defs/sha256"
        },
        "execution_identity": {
          "$ref": "#/$defs/sha256"
        },
        "selection_id": {
          "type": "string",
          "minLength": 1
        },
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "benchmark": {
          "const": "m3-v2"
        },
        "condition_id": {
          "const": "no_defense"
        },
        "evaluation_case_type": {
          "const": "benign_no_tool"
        },
        "authorization_regime": {
          "const": "auto_compiled"
        },
        "analysis_tier": {
          "const": "primary"
        },
        "source_record_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "work_item_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_sha256",
        "external_effects",
        "effect_backend",
        "model_output_is_untrusted_proposal",
        "host_or_provider_tools",
        "allowed_payload_class"
      ],
      "properties": {
        "policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "external_effects": {
          "const": false
        },
        "effect_backend": {
          "const": "m3_sandbox_fixture"
        },
        "model_output_is_untrusted_proposal": {
          "const": true
        },
        "host_or_provider_tools": {
          "const": false
        },
        "allowed_payload_class": {
          "const": "synthetic_m3_case"
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_sha256",
        "hard_spend_limit_cny",
        "abort_ceiling_cny",
        "pilot_work_items",
        "max_provider_calls"
      ],
      "properties": {
        "policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "hard_spend_limit_cny": {
          "const": 30.0
        },
        "abort_ceiling_cny": {
          "const": 27.0
        },
        "pilot_work_items": {
          "const": 1
        },
        "max_provider_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "single_use",
        "must_not_exist_before_execution",
        "provider_trace_path",
        "record_ledger_path"
      ],
      "properties": {
        "single_use": {
          "const": true
        },
        "must_not_exist_before_execution": {
          "const": true
        },
        "provider_trace_path": {
          "$ref": "#/$defs/project_path"
        },
        "record_ledger_path": {
          "$ref": "#/$defs/project_path"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "provider",
        "work_item",
        "locked_inputs",
        "safety",
        "budget",
        "outputs"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "$ref": "#/$defs/provider"
        },
        "work_item": {
          "$ref": "#/$defs/work_item"
        },
        "locked_inputs": {
          "type": "array",
          "minItems": 23,
          "maxItems": 23,
          "items": {
            "$ref": "#/$defs/locked_input"
          }
        },
        "safety": {
          "$ref": "#/$defs/safety"
        },
        "budget": {
          "$ref": "#/$defs/budget"
        },
        "outputs": {
          "$ref": "#/$defs/outputs"
        }
      }
    },
    "owner_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_kind",
        "approved_by_role",
        "approved_at",
        "approval_scope",
        "statement_sha256"
      ],
      "properties": {
        "approval_kind": {
          "type": "string",
          "minLength": 1
        },
        "approved_by_role": {
          "type": "string",
          "minLength": 1
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "approval_scope": {
          "const": "one_deepseek_pilot_work_item"
        },
        "statement_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_only",
        "execution_authorized",
        "formal_matrix_authorized",
        "result_admission_authorized",
        "candidate_manifest_sha256",
        "owner_approval"
      ],
      "properties": {
        "candidate_only": {
          "type": "boolean"
        },
        "execution_authorized": {
          "type": "boolean"
        },
        "formal_matrix_authorized": {
          "const": false
        },
        "result_admission_authorized": {
          "const": false
        },
        "candidate_manifest_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sha256"
            }
          ]
        },
        "owner_approval": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/owner_approval"
            }
          ]
        }
      }
    }
  }
}
