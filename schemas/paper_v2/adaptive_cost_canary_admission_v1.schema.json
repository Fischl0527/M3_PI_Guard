{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://m3.local/schemas/paper_v2/adaptive_cost_canary_admission_v1.schema.json",
  "title": "M3 paper-v2 adaptive cost canary admission v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_role",
    "approved_at",
    "status",
    "scope",
    "authorization",
    "evidence_boundary",
    "scope_sha256",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "m3-paper-v2-adaptive-cost-canary-admission-1.0"
    },
    "artifact_role": {
      "const": "adaptive_cost_canary_execution_authorization"
    },
    "approved_at": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "activated_for_adaptive_cost_canary_only"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "execution_identity",
        "provider_id",
        "endpoint_type",
        "model_role",
        "model_id",
        "task_count",
        "query_budget_per_task",
        "maximum_queries",
        "maximum_provider_calls",
        "hard_limit_cny",
        "output_root",
        "exact_command",
        "exact_command_sha256"
      ],
      "properties": {
        "run_id": {
          "const": "adaptive-cost-canary-primary-v1"
        },
        "execution_identity": {
          "$ref": "#/$defs/sha256"
        },
        "provider_id": {
          "const": "deepseek"
        },
        "endpoint_type": {
          "const": "official_api"
        },
        "model_role": {
          "const": "primary"
        },
        "model_id": {
          "const": "deepseek-v4-pro"
        },
        "task_count": {
          "const": 8
        },
        "query_budget_per_task": {
          "const": 50
        },
        "maximum_queries": {
          "const": 400
        },
        "maximum_provider_calls": {
          "const": 3200
        },
        "hard_limit_cny": {
          "const": 5.0
        },
        "output_root": {
          "const": "outputs/paper_upgrade_v2/adaptive_cost_canary_v1/primary"
        },
        "exact_command": {
          "type": "string",
          "minLength": 1
        },
        "exact_command_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_manifest_sha256",
        "candidate_scope_sha256",
        "owner_statement_sha256",
        "canary_execution_authorized",
        "formal_continuation_authorized",
        "result_admission_authorized"
      ],
      "properties": {
        "candidate_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_scope_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "owner_statement_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "canary_execution_authorized": {
          "const": true
        },
        "formal_continuation_authorized": {
          "const": false
        },
        "result_admission_authorized": {
          "const": false
        }
      }
    },
    "evidence_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "technical_cost_gate_only",
        "scientific_outcomes_may_be_reviewed",
        "provider_tools_enabled",
        "external_effects_enabled",
        "automatic_retries",
        "prompt_or_response_content_stored_in_provider_trace"
      ],
      "properties": {
        "technical_cost_gate_only": {
          "const": true
        },
        "scientific_outcomes_may_be_reviewed": {
          "const": false
        },
        "provider_tools_enabled": {
          "const": false
        },
        "external_effects_enabled": {
          "const": false
        },
        "automatic_retries": {
          "const": 0
        },
        "prompt_or_response_content_stored_in_provider_trace": {
          "const": false
        }
      }
    },
    "scope_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "manifest_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
