{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://m3-pi-guard.invalid/schemas/independent-blind-python-review-manifest-v3.json",
  "title": "M3-PI Guard Python-first independent blind review package manifest v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "files",
    "initially_empty_work_directories",
    "frozen_slots",
    "critical_bindings",
    "evidence_boundary",
    "single_use",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "m3-paper-v2-independent-blind-python-review-manifest-3.0"
    },
    "status": {"const": "sealed_python_first_review_package"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256", "role"],
        "properties": {
          "path": {"type": "string"},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "role": {"type": "string"}
        }
      }
    },
    "initially_empty_work_directories": {
      "const": [
        "work/private/registration",
        "work/private/authored_pairs",
        "work/private/labels",
        "work/private/scoring",
        "work/generated/receipts",
        "work/generated/signatures",
        "work/generated/release",
        "work/incoming_from_developer",
        "work/handoff",
        "work/runtime"
      ]
    },
    "frozen_slots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "rows", "sha256"],
      "properties": {
        "path": {
          "const": "review_source/protocols/paper_upgrade_v2/independent_blind_authoring_kit_v1/slots.jsonl"
        },
        "rows": {"const": 600},
        "sha256": {"const": "4ec78a15bf87473d56d9c4a1bb59f6fadd0d8fed76adf66a567c5e794b79a0a8"}
      }
    },
    "critical_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "closeout_core_sha256",
        "custodian_cli_sha256",
        "review_package_config_sha256"
      ],
      "properties": {
        "closeout_core_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "custodian_cli_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "review_package_config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "evidence_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_enumeration_used",
        "source_allowlist_entries",
        "real_authoring_pairs_copied",
        "real_candidate_rows_copied",
        "real_label_rows_copied",
        "credentials_read",
        "private_key_copied",
        "configuration_files_copied",
        "prior_outputs_copied",
        "powershell_wrappers_copied",
        "network_calls_made"
      ],
      "properties": {
        "source_enumeration_used": {"const": false},
        "source_allowlist_entries": {"const": 39},
        "real_authoring_pairs_copied": {"const": 0},
        "real_candidate_rows_copied": {"const": 0},
        "real_label_rows_copied": {"const": 0},
        "credentials_read": {"const": false},
        "private_key_copied": {"const": false},
        "configuration_files_copied": {"const": 0},
        "prior_outputs_copied": {"const": 0},
        "powershell_wrappers_copied": {"const": 0},
        "network_calls_made": {"const": 0}
      }
    },
    "single_use": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existing_destination_refused",
        "overwrite_supported",
        "all_runtime_outputs_under_gitignored_work",
        "private_key_required_package_external"
      ],
      "properties": {
        "existing_destination_refused": {"const": true},
        "overwrite_supported": {"const": false},
        "all_runtime_outputs_under_gitignored_work": {"const": true},
        "private_key_required_package_external": {"const": true}
      }
    },
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
