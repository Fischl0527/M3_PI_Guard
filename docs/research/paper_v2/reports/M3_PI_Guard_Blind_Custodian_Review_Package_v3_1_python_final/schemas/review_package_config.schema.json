{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://m3-pi-guard.invalid/schemas/independent-blind-python-review-config-v3.json",
  "title": "M3-PI Guard Python-first independent blind review package config v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["paths", "schema_version", "work_root"],
  "properties": {
    "schema_version": {
      "const": "m3-paper-v2-independent-blind-python-review-config-3.0"
    },
    "work_root": {"const": "work"},
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authored_pairs",
        "custody",
        "custody_signature",
        "custody_signature_receipt",
        "developer_handoff_dir",
        "developer_receipt",
        "developer_safe_final_dir",
        "developer_safe_integrity_receipt",
        "effect_receipt_bundle",
        "execution_admission",
        "execution_output_seal",
        "execution_release_dir",
        "execution_release_receipt",
        "execution_set",
        "identity_attestation",
        "label_file",
        "label_release_seal",
        "output_package",
        "pre_release_review",
        "private_audit_dir",
        "provider_request_chain_bundle",
        "provider_trace_receipt_bundle",
        "public_key",
        "registration",
        "registration_receipt",
        "registration_signature",
        "scoring_attestation",
        "scoring_attestation_receipt",
        "scoring_attestation_signature",
        "scoring_release_dir",
        "scoring_result_seal",
        "scoring_results",
        "scoring_results_release",
        "split_receipt",
        "split_timing",
        "unsigned_custody",
        "unsigned_registration",
        "unsigned_scoring_attestation"
      ],
      "properties": {
        "authored_pairs": {"const": "work/private/authored_pairs/authored_pairs.jsonl"},
        "custody": {"const": "work/generated/release/blind_custody_v2.json"},
        "custody_signature": {"const": "work/generated/signatures/custody_signature_base64.txt"},
        "custody_signature_receipt": {"const": "work/generated/receipts/custody_signature_verifier_receipt_v2.json"},
        "developer_handoff_dir": {"const": "work/handoff/developer_evidence_v3"},
        "developer_receipt": {"const": "work/generated/receipts/developer_execution_receipt_v3.json"},
        "developer_safe_final_dir": {"const": "work/handoff/developer_safe_final_v3"},
        "developer_safe_integrity_receipt": {"const": "work/generated/receipts/developer_safe_scoring_integrity_receipt_v2.json"},
        "effect_receipt_bundle": {"const": "work/incoming_from_developer/effect_receipt_bundle_v2.jsonl"},
        "execution_admission": {"const": "work/incoming_from_developer/execution_admission_v2.json"},
        "execution_output_seal": {"const": "work/incoming_from_developer/execution_output_seal_v2.json"},
        "execution_release_dir": {"const": "work/handoff/execution_only_v3"},
        "execution_release_receipt": {"const": "work/handoff/execution_only_v3/execution_release_receipt_v3.json"},
        "execution_set": {"const": "work/generated/release/blind_execution_v2.jsonl"},
        "identity_attestation": {"const": "work/private/registration/offline_identity_attestation.txt"},
        "label_file": {"const": "work/private/labels/blind_labels_v2.jsonl"},
        "label_release_seal": {"const": "work/generated/receipts/label_release_seal_v2.json"},
        "output_package": {"const": "work/incoming_from_developer/output_package_v2.jsonl"},
        "pre_release_review": {"const": "work/generated/receipts/pre_release_review_v2.json"},
        "private_audit_dir": {"const": "work/private/audit_bundle_v3"},
        "provider_request_chain_bundle": {"const": "work/incoming_from_developer/provider_request_chain_bundle_v2.jsonl"},
        "provider_trace_receipt_bundle": {"const": "work/incoming_from_developer/provider_trace_receipt_bundle_v2.jsonl"},
        "public_key": {"const": "work/generated/release/custodian_public_key.pem"},
        "registration": {"const": "work/generated/release/custodian_registration_v2.json"},
        "registration_receipt": {"const": "work/generated/receipts/custodian_registration_verifier_receipt_v2.json"},
        "registration_signature": {"const": "work/generated/signatures/registration_signature_base64.txt"},
        "scoring_attestation": {"const": "work/generated/receipts/custodian_scoring_attestation_v2.json"},
        "scoring_attestation_receipt": {"const": "work/generated/receipts/custodian_scoring_attestation_verifier_receipt_v2.json"},
        "scoring_attestation_signature": {"const": "work/generated/signatures/scoring_attestation_signature_base64.txt"},
        "scoring_release_dir": {"const": "work/generated/release/scoring_release_v3"},
        "scoring_result_seal": {"const": "work/generated/release/scoring_release_v3/custodian_scoring_result_seal_v2.json"},
        "scoring_results": {"const": "work/private/scoring/scoring_results_v2.jsonl"},
        "scoring_results_release": {"const": "work/generated/release/scoring_release_v3/scoring_results_v2.jsonl"},
        "split_receipt": {"const": "work/generated/receipts/split_receipt_v2.json"},
        "split_timing": {"const": "work/generated/receipts/split_timing_v3.json"},
        "unsigned_custody": {"const": "work/generated/signatures/unsigned_custody_v2.json"},
        "unsigned_registration": {"const": "work/generated/signatures/unsigned_registration_v2.json"},
        "unsigned_scoring_attestation": {"const": "work/generated/signatures/unsigned_scoring_attestation_v2.json"}
      }
    }
  }
}
