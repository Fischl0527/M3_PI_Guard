__pycache__/
*.pyc
.env
.venv/
.cache/
*.log

# Team-shared configuration uses config/project.env.example. Real credentials
# and machine-local paths stay in the ignored local companion file.
config/project.local.env
config/project.local.env.*
config/*.secret.env

# Local task prompts and personal progress notes are not submission artifacts.
DAY*-TASK.md
DAY*-REPORT-A.md
private_notes/
harness/tmp/
.tmp.driveupload/

# Resumable experiment lane/part files are transient; completed bundles keep
# consolidated raw logs, indices, manifests, metrics and statistics instead.
outputs/experiments/**/work/
outputs/experiments/**/.parts/
outputs/experiments/**/.*/

# Local model artifacts must never be committed.
models/
ollama_models/
*.gguf
*.safetensors
*.bin
*.pt
*.pth

# Official benchmark checkouts are reproducible caches, not vendored source.
# The tracked lock/index files under external/benchmarks record exact commits,
# licenses and compatibility counts.
external/benchmarks/agentdojo/
external/benchmarks/agentdyn/
external/benchmarks/injecagent/

# Strong-baseline source checkouts are reproducible caches. Protocol manifests
# record exact source URLs and commits.
external/baselines/
external/independent_blind/

# Holdout case content remains local even though independent-blind execution is
# outside the current paper scope.
m3_attacks/cases/paper_v1/m3_v2_sealed_holdout.jsonl

# Runtime outputs. Keep only curated sample logs.
outputs/runs/*
!outputs/runs/.gitkeep
!outputs/runs/stub_baseline.jsonl
!outputs/runs/stub_guarded.jsonl
!outputs/runs/qwen25_baseline_day2.jsonl
!outputs/runs/day3_stub_baseline_all.jsonl
!outputs/runs/day3_stub_guarded_all.jsonl
!outputs/runs/day3_qwen25_demo_baseline.jsonl
!outputs/runs/day3_qwen25_demo_guarded.jsonl
!outputs/runs/day3_qwen25_baseline_20.jsonl
!outputs/runs/day3_qwen25_guarded_20.jsonl
!outputs/runs/day3_stub_baseline_all.csv
!outputs/runs/day3_stub_guarded_all.csv
!outputs/runs/day3_qwen25_demo_baseline.csv
!outputs/runs/day3_qwen25_demo_guarded.csv
!outputs/runs/day3_qwen25_baseline_20.csv
!outputs/runs/day3_qwen25_guarded_20.csv
!outputs/runs/day6_demo_stub_matrix/
!outputs/runs/day6_demo_stub_matrix/**
outputs/metrics/*
!outputs/metrics/.gitkeep
!outputs/metrics/stub_compare_metrics.json
!outputs/metrics/day3_stub_summary.json
!outputs/metrics/day3_qwen25_summary_20.json
!outputs/metrics/day6_demo_stub_summary.csv
!outputs/metrics/day6_demo_stub_summary.json
!outputs/metrics/day6_demo_stub_summary_grouped_by_family.csv
outputs/figures/*

# Large generated research outputs and verifier workspaces stay local. The
# paper repository tracks code, frozen plans and compact derived tables/figures,
# not raw provider traces or recursive verification scratch trees.
outputs/experiments/
outputs/paper_upgrade_v1/
outputs/paper_upgrade_v2/
outputs/paper_v2/
outputs/verification/
outputs/document_qa/
outputs/report_qa/

# Historical execution captures are generated evidence, not source protocols.
protocols/**/execution/

# Sandbox runtime state. The committed canary is fake and local-only.
sandbox/outbox/*
!sandbox/outbox/.gitkeep
sandbox/logs/*
!sandbox/logs/.gitkeep
sandbox/translated_message.json
sandbox/secrets/*
!sandbox/secrets/api_key.txt
sandbox/public/agent_memory.txt

# Keep older generated packages local-only after the final v1.0 package exists.
release/M3_PI_Guard_v0.5/
